# =====================================================================
# Mahindra Auto Steel Private Limited (MASL) - Trolley Lifecycle & Maintenance Tracker
# Environment Variables Template (Copy to .env.local or Vercel Settings)
# =====================================================================

# Required: Dedicated Mahindra Auto Steel Private Limited (MASL) Firebase Web App Configuration
# Set these 6 variables in Vercel -> Project Settings -> Environment Variables
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional: Named Firestore Database ID (leave blank for standard "(default)" database)
VITE_FIREBASE_DATABASE_ID=""

# Optional: Set to "true" in production to skip demo dataset seeding completely
VITE_DISABLE_DEMO_SEED="false"

# Optional Server-Side / AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
